# Copy to backend/.env. Never commit the real file.
# XAMPP / MariaDB on the local machine. Start MySQL only; Apache is not required.
APP_NAME=Tuition Center MIS
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
DATABASE_URL=mysql+pymysql://tuition_app:change_me_strong@127.0.0.1:3306/tuition_db?charset=utf8mb4
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
START_SCHEDULER=true
TRUST_PROXY=false
SEED_ADMIN_EMAIL=admin@tuition.example
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Administrator
