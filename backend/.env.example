# Copy this file to backend/.env and adjust it for your machine.
# XAMPP's MySQL user is usually "root" with an empty password.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# mysql is the supported application database.
# Tests use SQLite automatically. Set TEST_DB=mysql to run tests on MySQL.
DB_ENGINE=mysql
DB_NAME=course_tuition_center_mis
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used by: python manage.py create_super_admin
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@tuition.local
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_PHONE=+93700000000
SUPER_ADMIN_GENDER=male
